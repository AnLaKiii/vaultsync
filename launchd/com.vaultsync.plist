<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vaultsync</string>
  <key>ProgramArguments</key>
  <array>
    <!-- KULLANICI_ADIN'i kendi kullanıcı adınla değiştir -->
    <string>/Users/KULLANICI_ADIN/.local/bin/vaultsync</string>
    <string>watch</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/vaultsync.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/vaultsync.err.log</string>
</dict>
</plist>
